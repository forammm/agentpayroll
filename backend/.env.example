PAYGUARD_APP_NAME=PayGuard AI API
PAYGUARD_APP_ENV=development
PAYGUARD_DEBUG=true
PAYGUARD_DATABASE_URL=postgresql+psycopg://payguard:payguard@localhost:5432/payguard
PAYGUARD_FRONTEND_ORIGIN=http://localhost:5173

# Payslip upload & extraction
PAYGUARD_UPLOAD_DIR=storage/payslips
PAYGUARD_MAX_UPLOAD_SIZE_MB=10
PAYGUARD_PAYSLIP_RETENTION_DAYS=365
PAYGUARD_OCR_ENABLED=true

# LangGraph verification workflow (Prompt 5)
# ANTHROPIC_API_KEY is read directly by the anthropic SDK - intentionally NOT prefixed
# with PAYGUARD_. Get a key at https://console.anthropic.com/. If unset, PAYGUARD_LLM_ENABLED
# should be false (verification still runs and returns a safe, non-AI fallback explanation).
ANTHROPIC_API_KEY=
PAYGUARD_LLM_ENABLED=true
PAYGUARD_LLM_MODEL=claude-opus-5
PAYGUARD_LLM_MAX_TOKENS=1024
PAYGUARD_LLM_TIMEOUT_SECONDS=20
PAYGUARD_VERIFICATION_TOLERANCE=1.00
